# PostgreSQL / TimescaleDB(對應 docker-compose.yml 的 db service)
DATABASE_URL=postgresql+psycopg://mini_edr:mini_edr@localhost:5432/mini_edr

# Velociraptor API client 設定檔路徑(mutual TLS,由
# `velociraptor config api_client` 產生,見 deploy/velociraptor/README.md 第 6 節)
VELOCIRAPTOR_API_CONFIG_PATH=./deploy/velociraptor/etc/api_client.yaml

# Dashboard 登入(Google SSO)。到 https://console.cloud.google.com/apis/credentials
# 建立 OAuth 2.0 用戶端(Web application),Authorized redirect URI 填
# http://localhost:8000/auth/callback(本機開發)或正式網域的等價位置。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 限制只有這個網域的 Google 帳號能登入,例如 example.com;本機開發可留空,
# 正式環境務必填,否則任何 Google 帳號都能登入。
GOOGLE_HOSTED_DOMAIN=
# session cookie 簽章密鑰,正式環境務必換成隨機字串(例如 openssl rand -hex 32)
SESSION_SECRET_KEY=dev-only-change-me
# frontend 開發伺服器位置(Vite 預設 5173),OAuth 登入完成後導回這裡,也用來
# 設定 CORS allow_origins
FRONTEND_ORIGIN=http://localhost:5173

# AI Alert Explain(Phase 6,選配)。走 OpenAI-compatible 的
# /chat/completions REST 介面,不綁定特定供應商,只要目標端點相容這個
# 介面規格就能用(OpenAI 本身、Azure OpenAI、內部自架的相容端點都算)。
# 三個值留空 = 停用這個功能,Dashboard 按「產生 AI 說明」會顯示服務未設定。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
