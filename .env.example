# PostgreSQL / TimescaleDB(對應 docker-compose.yml 的 db service)
DATABASE_URL=postgresql+psycopg://mini_edr:mini_edr@localhost:5432/mini_edr

# Velociraptor API client 設定檔路徑(mutual TLS,由
# `velociraptor config api_client` 產生,見 deploy/velociraptor/README.md 第 6 節)
VELOCIRAPTOR_API_CONFIG_PATH=./deploy/velociraptor/etc/api_client.yaml

# Dashboard 登入(Google SSO)。到 https://console.cloud.google.com/apis/credentials
# 建立 OAuth 2.0 用戶端(Web application),Authorized redirect URI 填
# http://localhost:8000/auth/callback(本機開發)或正式網域的等價位置。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 限制只有這個網域的 Google 帳號能登入。留空 = 不限制網域,只有要在本機
# 用別的 Google 帳號測試時才暫時清空,不要在正式環境留空。
GOOGLE_HOSTED_DOMAIN=xiyuebiomed.com.tw
# 這些 email(逗號分隔)一定是 admin,即使不是第一個登入的人;已存在但
# 角色不是 admin 的話,下次登入會被自動升級。見
# app/services/users.py 的 get_or_create_user。
SEED_ADMIN_EMAILS=finrodchen@xiyuebiomed.com.tw
# session cookie 簽章密鑰,正式環境務必換成隨機字串(例如 openssl rand -hex 32)
SESSION_SECRET_KEY=dev-only-change-me
# frontend 位置,OAuth 登入完成後導回這裡,也用來設定 CORS allow_origins。
# 本機用 `npm run dev` 開發是 Vite 預設的 5173;用 docker-compose 跑
# frontend service 則是 nginx 對外開的 8081(見 docker-compose.yml)——用哪
# 種方式啟動 frontend,這裡就要填對應的網址,兩者不一樣。
FRONTEND_ORIGIN=http://localhost:5173

# docker-compose 的 frontend service build image 時,會把這個網址燒進
# 前端靜態檔案當作要打的 backend API 位址(Vite build-time 限制,不是
# runtime 環境變數,見 frontend/Dockerfile)。本機用 docker compose 測試
# 整套服務可以留預設值;部署到 NAS 要換成瀏覽器實際連得到 backend 的
# 位址(NAS 的 IP 或內部 DNS 名稱 + 8080 埠),不是 localhost、也不是
# container 內部的 service name。
BACKEND_PUBLIC_URL=http://localhost:8080

# SNMP v2c 資產監控(印表機/NAS/防火牆等裝不了 Velociraptor agent 的裝置)。
# 唯讀 community string,明碼——v2c 沒有加密機制,靠網路區隔緩解(SNMP 只
# 開放給這台 backend 主機的來源 IP),見 app/core/config.py 的說明。
SNMP_COMMUNITY=
# 監控目標清單(IP/裝置類型),格式範本見 deploy/snmp/snmp_targets.example.json。
# 用 docker-compose 跑的話這個值會被 docker-compose.yml 的
# SNMP_TARGETS_CONFIG_PATH 覆蓋成容器內的掛載路徑,這裡的預設值只給本機
# `uv run`(cwd 在 backend/)用。
SNMP_TARGETS_CONFIG_PATH=../deploy/snmp/snmp_targets.json

# syslog 接收(PA-410 防火牆 + Synology NAS 共用同一個 port,見
# deploy/syslog/README.md)。SYSLOG_LISTEN_PORT 是後端監聽 UDP 的 port,
# 要跟 PA-410 上 syslog server profile 設定的目的 port、DSM 的記錄傳送
# 設定一致;docker-compose 部署要記得在 docker-compose.yml 幫 backend
# service 開對應的 UDP port mapping。
SYSLOG_LISTEN_PORT=5514
# 判斷收到的 syslog 是不是這台 NAS 自己送的(PA-410 是靠內容判斷,見
# app/services/syslog_listener.py 的 classify_source())。填 NAS 自己的
# LAN IP,留空 = 不比對,NAS 送來的內容會被歸類 other,只存原始 log、
# 不會跑登入失敗/暴力破解/大量刪除搬移的分析。
SYNOLOGY_NAS_SYSLOG_SOURCE_IP=
# PAN-OS User-ID API(封鎖動作用)。管理介面通常是自簽憑證,內網限定,跟
# 這個專案既有的「沒有憑證/密碼加密基礎設施」立場一致。
PANOS_API_BASE_URL=https://192.168.2.200
# 用 `GET https://<防火牆>/api/?type=keygen&user=<admin>&password=<pwd>`
# 產生一次,把回傳的 <key> 貼在這裡。
PANOS_API_KEY=
# 封鎖時打的 tag,必須跟 PA-410 上 Dynamic Address Group 比對的 tag 完全
# 一致(防火牆端要先設好 DAG + deny policy,這是一次性的手動設定)。
PANOS_BLOCK_TAG=mini-edr-blocked
# 封鎖幾秒後自動解除。實機上線後撞到真實教訓:PA-410 這種入門機型的
# registered-IP 容量有限,PAN-OS 內建的另一個 auto-tagging 機制設成永久
# 不過期,累積超過 1000 筆就把容量佔滿,連我們自己的 tag 都註冊不進去——
# 預設 24 小時自動過期,不要重蹈覆轍;設成 0 才是永久,需要真的想永久封鎖
# 再手動改。
PANOS_BLOCK_TIMEOUT_SECONDS=86400

# AI Alert Explain(Phase 6,選配)。走 OpenAI-compatible 的
# /chat/completions REST 介面,不綁定特定供應商,只要目標端點相容這個
# 介面規格就能用(OpenAI 本身、Azure OpenAI、內部自架的相容端點都算)。
# 三個值留空 = 停用這個功能,Dashboard 按「產生 AI 說明」會顯示服務未設定。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
