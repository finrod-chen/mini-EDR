# 依官方 Docker/.env 樣板調整:
# https://github.com/Velocidex/velociraptor/blob/master/Docker/.env
#
# 使用方式:
#   cp deploy/velociraptor/.env.example deploy/velociraptor/.env
#   # 依實際環境修改下面幾個值,再 docker compose up -d velociraptor-server

# 端點會連線的公開主機名稱。這台 NAS(Synology DS923+)已與 ~100 台端點在
# 同一內網、且有內部 DNS,建議填一個內部 DNS 名稱(例如
# velociraptor.internal.<你的網域>),而不是直接填 IP——之後 NAS 換 IP
# 不用重新推送端點 Agent。
VELOCIRAPTOR_HOSTNAME=velociraptor.internal.example.local

# 端點連線埠(client -> server)。
VELOCIRAPTOR_FRONTEND_PORT=8000

# GUI 埠。
VELOCIRAPTOR_GUI_PORT=8889

# 一般不用改。
VELOCIRAPTOR_DATASTORE_PATH=/datastore/
VELOCIRAPTOR_CONFIG_PATH=/etc/velociraptor/server.config.yaml

# 初始 admin 密碼,第一次啟動後「務必」在 GUI 裡改掉。
VELOCIRAPTOR_INITIAL_ADMIN_PASSWORD=password
